# Default: normalize to LF in the repo, checkout as native on each OS
* text=auto

# Shell scripts must stay LF
*.sh        text eol=lf
launch.sh   text eol=lf

# Windows batch and PowerShell get CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary

# Explicit text types
*.html      text
*.css       text
*.js        text
*.json      text
*.md        text